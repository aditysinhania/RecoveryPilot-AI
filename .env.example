# Application
APP_NAME=RecoveryPilot AI
APP_ENV=development
LOG_LEVEL=INFO
API_VERSION=v1

# API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,backend,nginx,frontend

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=recoverypilot
POSTGRES_PASSWORD=recoverypilot
POSTGRES_DB=recoverypilot
DATABASE_URL=postgresql+psycopg://recoverypilot:recoverypilot@127.0.0.1:5432/recoverypilot
DB_ECHO=false

# Placeholders — never commit real values
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret
GEMINI_API_KEY=placeholder_gemini_key
GEMINI_MODEL=gemini-2.5-flash

# Observability
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
APP_VERSION=0.1.0
BUILD_SHA=dev
REDIS_URL=

# JWT — set a strong secret in staging/production
JWT_SECRET=local-dev-jwt-secret-change-me-32b!!
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
