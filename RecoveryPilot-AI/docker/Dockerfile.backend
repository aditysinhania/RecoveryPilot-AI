FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    PATH="/root/.local/bin:$PATH" \
    PYTHONPATH="/repo:/repo/apps/backend:/repo/services/src:/repo/integrations/src:/repo/shared/src:/repo/simulator/src:/repo/database"

WORKDIR /repo

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.8.15 /uv /usr/local/bin/uv

COPY pyproject.toml ./
COPY apps/backend ./apps/backend
COPY services ./services
COPY integrations ./integrations
COPY simulator ./simulator
COPY shared ./shared
COPY database ./database

RUN uv sync --no-dev

WORKDIR /repo/apps/backend
EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=25s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/api/v1/live || exit 1

CMD ["uv", "run", "--project", "/repo", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
